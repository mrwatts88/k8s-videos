  "rules": [
    {
      "_doc": "go links like go/standup are said 'go slash standup'.",
      "pattern": "\\bgo/([a-z0-9-]+)",
      "replace": "go slash $1"
    },
    {
      "_doc": "Any remaining slash before a word, as in a path: /api/links is 'slash API slash links'.",
      "pattern": "/(?=\\w)",
      "replace": " slash "
    }
  ],
