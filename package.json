{
  "name": "k8s-videos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "node scripts/render.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -p .",
    "lint": "eslint src scripts webpack-override.mjs",
    "check:scripts": "node scripts/check-scripts.mjs",
    "check:manifests": "bash scripts/validate-manifests.sh",
    "check": "npm run typecheck && npm run lint && npm run check:scripts && npm run check:manifests",
    "setup:python": "python3 -m venv .venv && .venv/bin/pip install -r tools/requirements.txt && bash tools/fetch_models.sh",
    "narrate": ".venv/bin/python tools/narrate.py",
    "check:narration": ".venv/bin/python tools/check_narration.py",
    "check:lexicon": ".venv/bin/python tools/check_narration.py --lexicon"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@remotion/cli": "4.0.539",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.539",
    "@remotion/eslint-config-flat": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "@types/react": "18.3.12",
    "@types/webpack-env": "1.18.5",
    "eslint": "9.39.5",
    "typescript": "5.6.3"
  }
}
