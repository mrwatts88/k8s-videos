      "lines": [
        {
          "text": "You have a handful of servers, and a bunch of apps that need to run somewhere."
        },
        {
          "text": "The old way, you pick a server for each app, and the app lives there.",
          "senses": {
            "lives": "verb"
          }
        },
        {
          "text": "When that server dies, the app goes with it, and someone gets paged to move it by hand."
        },
        {
          "text": "Kubernetes turns the whole pool of machines into one place you can ask for things."
        },
        {
          "text": "You say: run three copies of this app."
        },
        {
          "text": "It decides where they go, skips the broken server, and you stop caring which machine runs what.",
          "pauseAfter": 0.4
        }
      ]
    },
