  "title": "What Kubernetes actually is",
  "scenes": [
    {
      "id": "title",
      "type": "title",
      "kicker": "Episode 0",
      "title": "What Kubernetes actually is",
      "subtitle": "A spec for what you want, and controllers that make it true",
      "lines": [
        {
          "text": "Before we write any real YAML, let's get the big idea of Kubernetes straight."
        },
        {
          "text": "Kubernetes is a description of what you want, plus a crowd of small programs that keep making it true.",
          "pauseAfter": 0.4
        }
      ]
    },
