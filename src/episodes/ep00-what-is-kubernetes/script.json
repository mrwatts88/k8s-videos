      "lines": [
        {
          "text": "Here's a real controller at work: the one that keeps a set of pods running."
        },
        {
          "text": "It wants three pods, three are running, so it has nothing to do."
        },
        {
          "text": "Now one pod crashes, or the server under it disappears."
        },
        {
          "text": "The controller sees two running, where the spec says three."
        },
        {
          "text": "So it asks for a new pod, and a moment later there are three again."
        },
        {
          "text": "Nobody got paged; the loop just closed the gap.",
          "pauseAfter": 0.5
        }
      ]
    },
