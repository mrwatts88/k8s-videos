      "lines": [
        {
          "text": "This is a spec, written in YAML: a Deployment for the go links API we'll build in this series."
        },
        {
          "text": "It says we want two copies running."
        },
        {
          "text": "And it says which container image to run, and on which port."
        },
        {
          "text": "Notice what it doesn't say: which server to use, or the steps to get there.",
          "senses": {
            "use": "verb"
          }
        },
        {
          "text": "On its own, this file does nothing at all.",
          "pauseAfter": 0.5
        }
      ]
    },
