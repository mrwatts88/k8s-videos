      "lines": [
        {
          "text": "Pods and the other objects in a cluster are grouped into namespaces, which work a lot like folders."
        },
        {
          "text": "kube-system holds the cluster's own add-ons."
        },
        {
          "text": "default is where things land when you don't name a namespace."
        },
        {
          "text": "Our go links service gets a namespace of its own, called golinks."
        },
        {
          "text": "Everything for it will live there: the API, the database, its config and its services.",
          "senses": {
            "live": "verb"
          }
        },
        {
          "text": "Namespaces also scope names and permissions, which later episodes lean on.",
          "pauseAfter": 0.4
        }
      ]
    },
