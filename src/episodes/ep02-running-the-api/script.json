      "title": "Running the API",
      "subtitle": "A Deployment, its ReplicaSet, and its pods",
      "lines": [
        {
          "text": "Last time we made an empty namespace called golinks."
        },
        {
          "text": "Now we put the go links API in it, with a Deployment.",
          "pauseAfter": 0.4
        }
      ]
    },
