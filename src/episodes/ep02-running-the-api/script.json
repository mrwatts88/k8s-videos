      "lines": [
        {
          "text": "That's a Deployment: a ReplicaSet, pods matched by labels, and resources the scheduler can plan around."
        },
        {
          "text": "Next time, we open up the ConfigMap and the Secret it reads from.",
          "pauseAfter": 0.6
        }
      ]
