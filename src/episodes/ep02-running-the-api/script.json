          ]
        }
      ],
      "lines": [
        {
          "text": "Here's the manifest. Like every object, it starts with a kind and a name, in our namespace, with our label.",
          "senses": {
            "object": "noun"
          }
        },
        {
          "text": "replicas: 2 is the desired state: two copies of the API, all the time."
        },
        {
          "text": "The selector says which pods belong to this Deployment."
        },
        {
          "text": "The template is the pod it stamps out. Its labels must match the selector, or the API server rejects the Deployment."
        },
        {
          "text": "Inside is the container: our image, and the port the app listens on, 8080, named http so the rest of the file can refer to it by name.",
          "pauseAfter": 0.3
        }
      ]
    },
    {
      "id": "config-preview",
      "type": "code",
      "file": "manifests/base/golinks-deployment.yaml",
      "range": [
        17,
        32
      ],
      "highlights": [
