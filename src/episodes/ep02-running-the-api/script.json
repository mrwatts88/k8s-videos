      "lines": [
        {
          "text": "Requests matter most to the scheduler."
        },
        {
          "text": "It only places a pod where its requests still fit. The server has just 50 millicores left unrequested, so it's out."
        },
        {
          "text": "Both agents have room, so it picks one, here agent one, and the pod is bound there."
        },
        {
          "text": "Note that it counts requests, not real usage. A node full of idle pods that asked for a lot still looks full.",
          "pauseAfter": 0.5
        }
      ]
    },
