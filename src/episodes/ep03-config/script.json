          "x": 500,
          "y": 640,
          "w": 600,
          "h": 60,
          "tone": "good",
          "hidden": true
        }
      ],
      "arrows": [
        {
          "id": "a1",
          "from": "img",
          "to": "lap",
          "hidden": true
        },
        {
          "id": "a2",
          "from": "img",
          "to": "test",
          "hidden": true
        },
        {
          "id": "a3",
          "from": "img",
          "to": "prod",
          "hidden": true
        }
      ],
      "steps": [
        {
          "at": 1,
          "show": [
            "lap",
            "test",
            "prod",
            "a1",
            "a2",
            "a3"
          ]
        },
        {
          "at": 2,
          "tone": {
            "lap": "warn",
            "test": "warn",
            "prod": "warn"
          }
        },
        {
          "at": 3,
          "show": [
            "note"
          ],
          "tone": {
            "lap": "neutral",
            "test": "neutral",
            "prod": "neutral"
          },
          "flow": [
            "a1",
            "a2",
            "a3"
          ]
        }
      ],
      "lines": [
        {
          "text": "A container image should be built once."
        },
        {
          "text": "The same image runs on a laptop, in a test cluster, and in production."
        },
        {
          "text": "What differs between those places is configuration: hostnames, log levels, passwords."
        },
        {
          "text": "So configuration stays out of the image, in objects of its own that the pod picks up when it starts.",
          "pauseAfter": 0.4
        }
      ]
    },
    {
      "id": "configmap-yaml",
      "type": "code",
      "file": "manifests/base/golinks-configmap.yaml",
      "highlights": [
        {
          "at": 0,
          "lines": [
            1,
            7
          ]
        },
        {
          "at": 1,
          "lines": [
            8,
            12
          ]
        },
        {
          "at": 2,
          "lines": [
            13,
            13
          ]
        },
        {
          "at": 3,
          "lines": [
            14,
            16
          ]
        }
      ],
      "lines": [
        {
          "text": "A ConfigMap is a named set of plain key and value pairs. Ours is golinks-config.",
          "say": "A ConfigMap is a named set of plain key and value pairs. Ours is golinks config."
        },
        {
          "text": "It says where the database is: the host, the port, the database name and the user."
        },
        {
          "text": "How chatty the logs should be: info, for now."
        },
        {
          "text": "And two settings for checking sign-in tokens, which we'll use in Episode 9.",
          "pauseAfter": 0.3,
          "senses": {
            "use": "verb"
          }
        }
      ]
    },
    {
      "id": "secret-yaml",
      "type": "code",
      "file": "manifests/base/postgres-secret.yaml",
      "highlights": [
        {
          "at": 0,
          "lines": [
            4,
            11
          ]
        },
        {
          "at": 1,
          "lines": [
            12,
            15
          ]
        },
        {
          "at": 2,
          "lines": [
            1,
            3
          ]
        }
      ],
      "lines": [
        {
          "text": "The password goes in a Secret instead. It looks almost the same: a kind, a name, and some data."
        },
        {
          "text": "stringData lets us write the values as plain text; Kubernetes stores them base64 encoded."
        },
        {
          "text": "And that's the catch: base64 is an encoding, not encryption.",
          "pauseAfter": 0.3
        }
      ]
    },
    {
      "id": "base64",
      "type": "terminal",
      "title": "~/k8s-videos",
      "steps": [
        {
          "at": 0,
          "command": "kubectl get secret postgres-credentials -n golinks -o yaml | grep PASSWORD",
          "output": [
            "  POSTGRES_PASSWORD: Y2hhbmdlLW1lLWluLWEtcmVhbC1jbHVzdGVy"
          ]
        },
        {
          "at": 1,
          "command": "echo Y2hhbmdlLW1lLWluLWEtcmVhbC1jbHVzdGVy | base64 -d",
          "output": [
            "change-me-in-a-real-cluster"
          ]
        }
      ],
      "lines": [
        {
          "text": "Read the Secret back, and the password looks scrambled.",
          "senses": {
            "read": "present"
          }
        },
        {
          "text": "One base64 command later, it's plain text again."
        },
        {
          "text": "Anyone who can read Secrets in this namespace can read the password. So what does keep it safe?",
          "senses": {
            "read": "present"
          },
          "pauseAfter": 0.4
        }
      ]
    },
    {
      "id": "protect",
      "type": "diagram",
      "title": "What actually protects a Secret",
      "boxes": [
        {
          "id": "s",
          "label": "Secret",
          "sublabel": "postgres-credentials",
          "x": 600,
          "y": 40,
          "w": 400,
          "h": 120,
          "tone": "accent"
        },
        {
          "id": "rbac",
          "label": "RBAC",
          "sublabel": "who may read Secrets",
          "x": 60,
          "y": 400,
          "w": 440,
          "h": 140,
          "hidden": true
        },
        {
          "id": "enc",
          "label": "Encryption at rest",
          "sublabel": "k3s --secrets-encryption",
          "x": 580,
          "y": 400,
          "w": 440,
          "h": 140,
          "hidden": true
        },
        {
          "id": "git",
          "label": "Not in git",
          "sublabel": "Sealed Secrets, External Secrets",
          "x": 1100,
          "y": 400,
          "w": 440,
          "h": 140,
          "hidden": true
        }
      ],
      "arrows": [
        {
          "id": "a1",
          "from": "s",
          "to": "rbac",
          "hidden": true
        },
        {
          "id": "a2",
          "from": "s",
          "to": "enc",
          "hidden": true
        },
        {
          "id": "a3",
          "from": "s",
          "to": "git",
          "hidden": true
        }
      ],
      "steps": [
        {
          "at": 1,
          "show": [
            "rbac",
            "a1"
          ],
          "focus": [
            "rbac"
          ]
        },
        {
          "at": 2,
          "show": [
            "enc",
            "a2"
          ],
          "focus": [
            "enc"
          ]
        },
        {
          "at": 3,
          "show": [
            "git",
            "a3"
          ],
          "focus": [
            "git"
          ]
        },
        {
          "at": 4,
          "focus": []
        }
      ],
      "lines": [
        {
          "text": "Three things, none of which is base64."
        },
        {
          "text": "First, access control: Kubernetes' role rules decide who may read Secrets at all, and most people shouldn't.",
          "senses": {
            "read": "present"
          }
        },
        {
          "text": "Second, encryption at rest: start the k3s server with secrets encryption on, and Secrets are encrypted in its datastore."
        },
        {
          "text": "Third, keep real values out of git. Tools like Sealed Secrets, or External Secrets pulling from a vault, put the real password in at deploy time."
        },
        {
          "text": "Our file is an example with a placeholder password, so it's fine in the repo. A real one never is.",
          "pauseAfter": 0.5
        }
      ]
    },
    {
      "id": "wiring",
      "type": "code",
      "file": "manifests/base/golinks-deployment.yaml",
      "range": [
        17,
        32
      ],
      "highlights": [
        {
          "at": 0,
          "lines": [
            24,
            26
          ]
        },
        {
          "at": 1,
          "lines": [
            27,
            32
          ]
        }
      ],
      "lines": [
        {
          "text": "Back in the Deployment, envFrom turns every key in the ConfigMap into an environment variable."
        },
        {
          "text": "For the Secret we pick just one key, POSTGRES_PASSWORD, and hand it to the app as DATABASE_PASSWORD.",
          "say": "For the Secret we pick just one key, postgres password, and hand it to the app as database password.",
          "pauseAfter": 0.3
        }
      ]
    },
    {
      "id": "env",
      "type": "terminal",
      "title": "~/k8s-videos",
      "steps": [
        {
          "at": 0,
          "command": "kubectl exec deploy/golinks -n golinks -- env | grep DATABASE",
          "output": [
            "DATABASE_HOST=postgres-0.postgres.golinks.svc.cluster.local",
            "DATABASE_NAME=golinks",
            "DATABASE_PORT=5432",
            "DATABASE_USER=golinks",
            "DATABASE_PASSWORD=change-me-in-a-real-cluster"
          ]
        }
      ],
      "lines": [
        {
          "text": "Ask a running pod for its environment, and every value is there."
        },
        {
          "text": "Including the password, which is one more reason to keep exec rights for the people who need them.",
          "pauseAfter": 0.4
        }
      ]
    },
    {
      "id": "read-once",
      "type": "diagram",
      "title": "Read once, at start",
      "boxes": [
        {
          "id": "cm",
          "label": "ConfigMap",
          "sublabel": "LOG_LEVEL=info",
          "x": 600,
          "y": 40,
          "w": 400,
          "h": 120,
          "tone": "accent"
        },
        {
          "id": "cm2",
          "label": "ConfigMap",
          "sublabel": "LOG_LEVEL=debug",
          "x": 600,
          "y": 40,
          "w": 400,
          "h": 120,
          "tone": "warn",
          "hidden": true
        },
        {
          "id": "old",
          "kind": "pod",
          "label": "running pod",
          "sublabel": "still sees info",
          "x": 200,
          "y": 460,
          "w": 480,
          "h": 120
        },
        {
          "id": "new",
          "kind": "pod",
          "label": "restarted pod",
          "sublabel": "sees debug",
          "x": 920,
          "y": 460,
          "w": 480,
          "h": 120,
          "tone": "good",
          "hidden": true
        }
      ],
      "arrows": [
        {
          "id": "a1",
          "from": "cm",
          "to": "old",
          "label": "copied at start"
        },
        {
          "id": "a2",
          "from": "cm2",
          "to": "new",
          "tone": "good",
          "hidden": true
        }
      ],
      "steps": [
        {
          "at": 1,
          "hide": [
            "cm"
          ],
          "show": [
            "cm2"
          ],
          "tone": {
            "old": "bad"
          }
        },
        {
          "at": 2,
          "show": [
            "new",
            "a2"
          ],
          "focus": [
            "new"
          ]
        },
        {
          "at": 3,
          "focus": []
        }
      ],
      "lines": [
        {
          "text": "One thing surprises everyone: environment variables are copied in once, when the container starts."
        },
        {
          "text": "Change the ConfigMap, and the running pods carry on with the old values."
        },
        {
          "text": "They pick up the new ones only when they restart. kubectl rollout restart replaces them one at a time."
        },
        {
          "text": "We'll try that in Episode 4, once the pods can become ready.",
          "pauseAfter": 0.5
        }
      ]
    },
    {
      "id": "logs",
      "type": "terminal",
      "title": "~/k8s-videos",
      "steps": [
        {
          "at": 0,
          "command": "kubectl logs deploy/golinks -n golinks",
          "output": [
            "Found 2 pods, using pod/golinks-7d9c5b6f4d-v8mzq",
            "{\"time\":\"2026-11-02T14:03:11Z\",\"level\":\"INFO\",\"msg\":\"starting golinks\",\"version\":\"0.1.0\"}",
            "{\"time\":\"2026-11-02T14:03:11Z\",\"level\":\"INFO\",\"msg\":\"config loaded\",\"db_host\":\"postgres-0.postgres.golinks.svc.cluster.local\"}",
            "{\"time\":\"2026-11-02T14:03:11Z\",\"level\":\"INFO\",\"msg\":\"listening\",\"port\":8080}",
            "{\"time\":\"2026-11-02T14:03:16Z\",\"level\":\"WARN\",\"msg\":\"database not reachable\",\"err\":\"no such host\"}"
          ]
        },
        {
          "at": 3,
          "command": "kubectl logs -l app.kubernetes.io/name=golinks -n golinks --prefix --tail=1",
          "output": [
            "[pod/golinks-7d9c5b6f4d-v8mzq/golinks] {\"time\":\"2026-11-02T14:09:46Z\",\"level\":\"WARN\",\"msg\":\"database not reachable\",\"err\":\"no such host\"}",
            "[pod/golinks-7d9c5b6f4d-wq7tn/golinks] {\"time\":\"2026-11-02T14:09:48Z\",\"level\":\"WARN\",\"msg\":\"database not reachable\",\"err\":\"no such host\"}"
          ]
        }
      ],
      "lines": [
        {
          "text": "Now, the logs. Whatever the app prints to its output, kubectl logs can show you."
        },
        {
          "text": "Pointed at the Deployment, it picks one of the two pods and says which."
        },
        {
          "text": "The app started, loaded its config, and listens on 8080. Then it warns that the database host doesn't exist, which is exactly why these pods aren't ready."
        },
        {
          "text": "To see every pod at once, select them by label. --prefix says which pod each line came from, and -f would keep following.",
          "say": "To see every pod at once, select them by label. The prefix flag says which pod each line came from, and dash f would keep following."
        },
        {
          "text": "Where these lines are stored, and what happens to them when a pod goes away, is a whole episode of its own: Episode 7.",
          "pauseAfter": 0.5
        }
      ]
    },
    {
      "id": "next",
      "type": "title",
      "kicker": "Coming up",
      "title": "Episode 4: The database",
      "subtitle": "Postgres as a StatefulSet",
      "lines": [
        {
          "text": "That's configuration: a ConfigMap for settings, a Secret for the password, both read when the pod starts.",
          "senses": {
            "read": "past"
          }
        },
        {
          "text": "Next time, we give these pods the database they keep asking for.",
          "pauseAfter": 0.6
        }
      ]
    }
  ]
