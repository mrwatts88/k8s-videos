{
  "id": "ep03-config",
  "number": 3,
  "title": "Configuration",
  "scenes": [
    {
      "id": "title",
      "type": "title",
      "kicker": "Episode 3",
      "title": "Configuration",
      "subtitle": "ConfigMaps and Secrets",
      "lines": [
        {
          "text": "Last time, the Deployment pointed at a ConfigMap and a Secret, and we skipped over both."
        },
        {
          "text": "Today we open them up, and take a first look at the app's logs.",
          "pauseAfter": 0.4
        }
      ]
    },
    {
      "id": "why",
      "type": "diagram",
      "title": "One image, many places",
