          "sublabel": "LOG_LEVEL=debug",
          "x": 60,
          "y": 420,
          "w": 440,
          "h": 130,
          "hidden": true
        },
        {
          "id": "test",
          "label": "Test cluster",
          "sublabel": "DATABASE_HOST=pg-test",
          "x": 580,
          "y": 420,
          "w": 440,
          "h": 130,
          "hidden": true
        },
        {
          "id": "prod",
          "label": "Production",
          "sublabel": "DATABASE_HOST=postgres-0...",
          "x": 1100,
          "y": 420,
          "w": 440,
          "h": 130,
          "hidden": true
        },
        {
          "id": "note",
