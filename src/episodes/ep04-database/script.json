  "scenes": [
    {
      "id": "title",
      "type": "title",
      "kicker": "Episode 4",
      "title": "The database",
      "subtitle": "Postgres as a StatefulSet",
      "lines": [
        {
          "text": "Since Episode 2, our API pods have been asking for a database that isn't there."
        },
        {
          "text": "Today we give them one: Postgres, run as a StatefulSet, with a disk that outlasts the pod.",
          "pauseAfter": 0.4
        }
      ]
    },
    {
