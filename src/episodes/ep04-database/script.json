          "sublabel": "/var/lib/rancher/k3s/storage",
          "x": 1020,
          "y": 600,
          "w": 520,
          "h": 120,
          "hidden": true
        },
        {
          "id": "pod",
          "kind": "pod",
          "label": "postgres-0",
          "sublabel": "mounts the claim",
          "x": 60,
