          "h": 90,
          "hidden": true
        },
        {
          "id": "p2",
          "kind": "pod",
          "label": "golinks pod",
          "x": 1240,
          "y": 520,
          "w": 320,
          "h": 90,
          "hidden": true
        }
      ],
      "arrows": [
        {
          "id": "a1",
          "from": "laptop",
          "to": "dns",
          "label": "where is it?",
          "hidden": true
        },
        {
