{
  "id": "ep05-reaching-it",
  "number": 5,
  "title": "Reaching it",
  "scenes": [
    {
      "id": "title",
      "type": "title",
      "kicker": "Episode 5",
      "title": "Reaching it",
      "subtitle": "Load balancer, Ingress, Service and DNS",
      "lines": [
        {
          "text": "The API is running, and it has its database. But so far, the only way in has been kubectl."
        },
        {
          "text": "Today we follow one request from a laptop to a pod, and build every hop along the way.",
          "pauseAfter": 0.4
        }
      ]
    },
    {
      "id": "path",
      "type": "diagram",
      "title": "One request, four hops",
      "boxes": [
        {
          "id": "laptop",
          "label": "Laptop",
