{
  "id": "ep06-health-probes",
  "number": 6,
  "title": "Health checks",
  "scenes": [
    {
      "id": "title",
      "type": "title",
      "kicker": "Episode 6",
      "title": "Health checks",
      "subtitle": "Startup, liveness and readiness probes",
      "lines": [
        {
          "text": "Last time, one word kept coming up: only ready pods get traffic."
        },
        {
          "text": "Today we look at who decides that, and at what Kubernetes does when a pod isn't healthy.",
          "pauseAfter": 0.4
        }
      ]
    },
    {
      "id": "probe",
      "type": "diagram",
      "title": "What a probe is",
      "boxes": [
        {
          "id": "node",
          "kind": "group",
          "label": "k3s-agent-1",
          "x": 60,
