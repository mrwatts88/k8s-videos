          "x": 1040,
          "y": 520,
          "w": 500,
          "h": 110,
          "tone": "warn",
          "hidden": true
        }
      ],
      "arrows": [
        {
          "id": "chk",
          "from": "kubelet",
          "to": "pod",
          "label": "GET /healthz"
        }
      ],
      "steps": [
        {
          "at": 0,
          "focus": [
            "kubelet"
          ],
          "flow": [
            "chk"
          ]
        },
        {
          "at": 1,
          "focus": [],
          "show": [
            "kinds"
          ]
        },
        {
          "at": 2,
          "show": [
            "pass",
            "fail"
          ]
        },
        {
          "at": 3,
          "show": [
            "thr"
          ],
          "flow": []
        }
      ],
      "lines": [
        {
          "text": "A probe is a check that the kubelet, the agent on each node, runs against a container on a schedule."
        },
        {
          "text": "It can make an HTTP request, open a TCP connection, make a gRPC call, or run a command inside the container. Ours are all HTTP."
        },
        {
          "text": "Any status from 200 to 399 is a pass. Anything else, or no answer within the timeout, is a failure."
        },
        {
          "text": "One miss means nothing. The kubelet acts only after failureThreshold misses in a row.",
          "pauseAfter": 0.4
        }
      ]
    },
    {
      "id": "three",
      "type": "diagram",
      "title": "Three probes, three jobs",
      "boxes": [
        {
          "id": "st",
          "label": "Startup",
          "sublabel": "has it started yet?",
          "x": 60,
          "y": 80,
          "w": 460,
          "h": 140,
          "hidden": true
        },
        {
          "id": "li",
          "label": "Liveness",
          "sublabel": "is it stuck for good?",
          "x": 570,
          "y": 80,
          "w": 460,
          "h": 140,
          "hidden": true
        },
        {
          "id": "re",
          "label": "Readiness",
          "sublabel": "should it get traffic now?",
          "x": 1080,
          "y": 80,
          "w": 460,
          "h": 140,
          "hidden": true
        },
        {
          "id": "st2",
          "kind": "note",
          "label": "the other two wait for it",
          "x": 60,
          "y": 330,
          "w": 460,
          "h": 80,
          "hidden": true
        },
        {
          "id": "st3",
          "kind": "note",
          "label": "fails: container restarted",
          "x": 60,
          "y": 490,
          "w": 460,
          "h": 80,
          "tone": "bad",
          "hidden": true
        },
        {
          "id": "li3",
          "kind": "note",
          "label": "fails: container restarted",
          "x": 570,
          "y": 490,
          "w": 460,
          "h": 80,
          "tone": "bad",
          "hidden": true
        },
        {
          "id": "re3",
          "kind": "note",
          "label": "fails: out of the Service",
          "x": 1080,
          "y": 490,
          "w": 460,
          "h": 80,
          "tone": "warn",
          "hidden": true
        },
        {
          "id": "re4",
          "kind": "note",
          "label": "no restart, back when it passes",
          "x": 1080,
          "y": 620,
          "w": 460,
          "h": 80,
