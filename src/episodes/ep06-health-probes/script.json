          "kind": "pod",
          "label": "golinks pod",
          "sublabel": "port 8080",
          "x": 600,
          "y": 270,
          "w": 300,
          "h": 100
        },
        {
          "id": "kinds",
          "kind": "note",
          "label": "HTTP, TCP, gRPC or a command",
          "x": 120,
          "y": 560,
          "w": 780,
          "h": 80,
          "hidden": true
        },
        {
          "id": "pass",
          "kind": "note",
