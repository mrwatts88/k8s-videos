          "x": 640,
          "y": 580,
          "w": 420,
          "h": 120,
          "hidden": true
        }
      ],
      "arrows": [
        {
          "id": "a1",
          "from": "app",
          "to": "ctd",
          "label": "stdout",
          "hidden": true
        },
        {
          "id": "a2",
