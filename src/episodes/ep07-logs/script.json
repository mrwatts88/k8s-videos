          "hidden": true
        }
      ],
      "steps": [
        {
          "at": 0,
          "focus": [
            "app"
          ]
        },
        {
          "at": 1,
          "focus": [],
          "show": [
            "ctd",
            "a1",
            "file",
            "a2"
          ],
          "flow": [
            "a1",
            "a2"
          ]
        },
        {
          "at": 2,
          "flow": [],
          "show": [
            "kl",
            "a3"
          ]
        }
      ],
      "lines": [
        {
          "text": "Our app writes one JSON line per event to standard output. It writes no log files of its own, and it never sends logs anywhere itself."
        },
        {
          "text": "containerd, the runtime from Episode 1, catches that output and appends it to a file on the node, in a folder for each pod."
        },
        {
          "text": "The kubelet rotates those files: by default at 10 MiB, keeping 5.",
          "say": "The kubelet rotates those files: by default at ten mebibytes, keeping five.",
          "pauseAfter": 0.4
        }
      ]
    },
    {
      "id": "on-node",
      "type": "terminal",
      "title": "admin@k3s-agent-1",
      "prompt": "$",
      "steps": [
        {
          "at": 0,
          "command": "sudo ls /var/log/pods | grep golinks",
          "output": [
            "golinks_golinks-5f8b6c7d9d-k4xzt_3f9c2e71-8a4d-4b6e-9c15-7d2a0e8b4f63",
            "golinks_postgres-0_b71e4d02-5c3a-4f8e-a9d6-1e0f7c2b8a45"
          ]
        },
        {
          "at": 1,
          "command": "sudo ls /var/log/pods/golinks_golinks-5f8b6c7d9d-k4xzt_*/golinks",
          "output": [
            "0.log  1.log"
          ]
        },
        {
          "at": 3,
          "command": "sudo tail -n 1 /var/log/pods/golinks_golinks-5f8b6c7d9d-k4xzt_*/golinks/1.log",
          "output": [
            "2026-11-02T15:04:10.412873160Z stdout F {\"time\":\"2026-11-02T15:04:10Z\",\"level\":\"DEBUG\",\"msg\":\"GET /readyz\",\"status\":200,\"ms\":1}"
          ]
        }
      ],
      "lines": [
        {
          "text": "Here they are on the node: a folder per pod, named for its namespace, the pod, and the pod's unique ID."
        },
        {
          "text": "Inside, one file per container start. 0.log is the container we froze in Episode 6.",
          "say": "Inside, one file per container start. Zero dot log is the container we froze in Episode 6."
        },
        {
          "text": "1.log is the one running now.",
          "say": "One dot log is the one running now."
        },
        {
          "text": "Each line is exactly what the app wrote, with a timestamp and the stream name in front.",
          "pauseAfter": 0.4
        }
      ]
    },
    {
