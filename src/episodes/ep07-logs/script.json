            "b2",
            "b3"
          ]
        },
        {
          "at": 1,
          "flow": [],
          "show": [
            "n1",
            "n2",
            "n3"
          ]
        }
      ],
      "lines": [
        {
          "text": "So when you run kubectl logs, the API server asks that node's kubelet, and the kubelet reads the file."
        },
        {
          "text": "That's why it shows one pod at a time, only what's still on that node, and why previous reaches back one restart and no further."
        },
        {
          "text": "A Service has no logs of its own. kubectl logs on a Service or a Deployment just picks one pod behind it.",
          "pauseAfter": 0.4
        }
      ]
    },
    {
      "id": "lost",
      "type": "diagram",
      "title": "When logs disappear",
      "boxes": [
        {
          "id": "l1",
          "kind": "note",
          "label": "pod deleted, or replaced by a rolling update: its files go with it",
          "x": 140,
          "y": 120,
          "w": 1320,
          "h": 110,
          "tone": "bad",
          "hidden": true
        },
        {
          "id": "l2",
          "kind": "note",
          "label": "node lost: every file on it goes too",
          "x": 140,
          "y": 300,
          "w": 1320,
          "h": 110,
          "tone": "bad",
          "hidden": true
        },
        {
          "id": "l3",
          "kind": "note",
          "label": "Kubernetes keeps no log history of its own",
          "x": 140,
          "y": 480,
          "w": 1320,
          "h": 110,
          "tone": "warn",
          "hidden": true
        }
      ],
      "arrows": [],
      "steps": [
        {
          "at": 0,
          "show": [
            "l1"
          ]
        },
        {
          "at": 1,
          "show": [
            "l2"
          ]
        },
        {
          "at": 2,
          "show": [
            "l3"
          ]
        }
      ],
      "lines": [
        {
          "text": "And those files don't last. Delete a pod, or let a rolling update replace it, and its log files are deleted with it."
        },
        {
          "text": "Lose a node, and everything on it is gone."
        },
        {
          "text": "Kubernetes itself keeps no log history. The docs call this cluster-level logging, and leave it to you.",
          "pauseAfter": 0.4
        }
      ]
    },
