{
  "id": "ep07-logs",
  "number": 7,
  "title": "Logs",
  "scenes": [
    {
      "id": "title",
      "type": "title",
      "kicker": "Episode 7",
      "title": "Logs",
      "subtitle": "Where they go, on-prem",
      "lines": [
        {
          "text": "Last time, a container was restarted, and kubectl logs could show only the last lines of the old one."
        },
        {
          "text": "Today: where those lines actually live, why they don't last, and how to keep them.",
          "senses": {
            "live": "verb"
          },
          "pauseAfter": 0.4
        }
      ]
    },
    {
      "id": "stdout",
      "type": "diagram",
      "title": "From the app to a file on the node",
      "boxes": [
        {
          "id": "node",
          "kind": "group",
          "label": "k3s-agent-1",
          "x": 60,
          "y": 60,
          "w": 1480,
          "h": 680
        },
        {
          "id": "app",
          "kind": "pod",
          "label": "golinks container",
          "sublabel": "one JSON line per event",
          "x": 120,
          "y": 160,
          "w": 420,
          "h": 120
        },
        {
          "id": "ctd",
          "label": "containerd",
          "sublabel": "catches stdout and stderr",
          "x": 640,
          "y": 160,
          "w": 420,
          "h": 120,
          "hidden": true
        },
        {
          "id": "file",
          "kind": "note",
          "label": "/var/log/pods/<namespace>_<pod>_<uid>/<container>/",
          "x": 400,
          "y": 400,
          "w": 960,
          "h": 90,
          "tone": "accent",
          "hidden": true
        },
        {
          "id": "kl",
