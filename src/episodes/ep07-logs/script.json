      ],
      "lines": [
        {
          "text": "Retention is 336 hours, which is 14 days. The compactor deletes anything older.",
          "say": "Retention is three hundred thirty-six hours, which is fourteen days. The compactor deletes anything older."
        },
        {
          "text": "One replica, with a 20 GiB volume from local-path, the same storage class Postgres uses.",
          "senses": {
            "uses": "verb"
          },
          "say": "One replica, with a twenty gig volume from local path, the same storage class Postgres uses."
        },
        {
          "text": "The rest turns off pieces a single pod doesn't need.",
