      "title": "Auth",
      "subtitle": "Keycloak tokens for the API",
      "lines": [
        {
          "text": "go is on HTTPS now, but there's still not a single link in it."
        },
        {
          "text": "Today callers prove who they are, the API checks them, and the first links go in.",
          "pauseAfter": 0.4
        }
      ]
    },
