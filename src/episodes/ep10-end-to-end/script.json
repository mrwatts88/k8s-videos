{
  "id": "ep10-end-to-end",
  "number": 10,
  "title": "End to end",
  "scenes": [
    {
      "id": "title",
      "type": "title",
      "kicker": "Episode 10",
      "title": "End to end",
      "subtitle": "One request, every hop",
      "lines": [
        {
          "text": "Nine episodes, nine pieces. Today we put them together, and follow a single request all the way through."
        },
        {
          "text": "At every hop, there's a command that proves that piece is doing its job.",
          "pauseAfter": 0.4
        }
      ]
    },
    {
      "id": "jira",
      "type": "terminal",
      "title": "laptop",
      "steps": [
        {
          "at": 0,
          "command": "cat jira.json",
          "output": [
            "{\"target\": \"https://jira.corp.internal/browse/{1}\"}"
          ]
        },
        {
          "at": 1,
          "command": "URL=https://go.corp.internal/api/links/jira"
        },
        {
          "at": 2,
          "command": "curl -si -T jira.json -H \"Authorization: Bearer $MY_TOKEN\" $URL | head -1",
          "output": [
            "HTTP/2 201"
          ]
        },
        {
          "at": 3,
          "command": "curl -sI https://go.corp.internal/jira/1234 | grep -E 'HTTP|loc'",
          "output": [
            "HTTP/2 302",
            "location: https://jira.corp.internal/browse/1234"
          ]
        }
      ],
      "lines": [
        {
          "text": "First, one more link: jira. Its target has a placeholder, number one, filled in from the path."
        },
        {
          "text": "Its address in the links API, as in the last episode."
        },
        {
          "text": "Create it with my own token, from signing in. 201."
        },
        {
          "text": "Now go slash jira slash 1234 answers 302, straight to that ticket. That's the request we'll follow.",
          "say": "Now go slash jira slash one two three four answers 302, straight to that ticket. That's the request we'll follow.",
          "pauseAfter": 0.4
        }
      ]
    },
