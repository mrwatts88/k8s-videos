      "lines": [
        {
          "text": "Here's the prod overlay, and it's short. Use the golinks namespace, and start from the base, two folders up.",
          "say": "Here's the prod overlay, and it's short. Use the go links namespace, and start from the base, two folders up.",
          "senses": {
            "use": "verb"
          }
        },
        {
          "text": "Add a label, environment: prod, to every object it makes.",
          "senses": {
            "object": "noun"
          }
        },
        {
          "text": "This is labels, not the older commonLabels, on purpose: commonLabels also changes selectors, and a Deployment's selector can't be changed once it exists."
        },
        {
          "text": "And pin the image tag. Releasing a new version of golinks means changing this one line.",
          "say": "And pin the image tag. Releasing a new version of go links means changing this one line.",
          "pauseAfter": 0.4
        }
      ]
    },
